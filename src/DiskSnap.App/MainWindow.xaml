<Window x:Class="DiskSnap.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DiskSnap.App"
        Title="DiskSnap" Height="760" Width="1180" MinHeight="560" MinWidth="900">
    <Window.Resources>
        <local:DepthToIndentConverter x:Key="DepthToIndentConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.Column="0" Margin="0,0,12,10" Padding="12" BorderBrush="#FFD0D0D0" BorderThickness="1" CornerRadius="4">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                <StackPanel>
                    <TextBlock Text="Drives and snapshots" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Scan selected" Command="{Binding ScanCommand}" Padding="12,5" Margin="0,0,8,0" />
                        <Button Content="Cancel" Command="{Binding CancelCommand}" Padding="12,5" Margin="0,0,8,0" />
                        <Button Content="Settings" Click="SettingsClick" Padding="12,5" />
                    </StackPanel>
                    <ProgressBar Height="5" IsIndeterminate="{Binding IsScanning}" Margin="0,0,0,6" />
                    <TextBlock Text="{Binding CurrentPath}" TextTrimming="CharacterEllipsis" ToolTip="{Binding CurrentPath}" Margin="0,0,0,4" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="Items scanned: " />
                        <TextBlock Text="{Binding ItemsScanned, StringFormat={}{0:N0}}" Margin="0,0,12,0" />
                        <TextBlock Text="Skipped: " />
                        <TextBlock Text="{Binding SkippedCount, StringFormat={}{0:N0}}" />
                    </StackPanel>
                    <TextBlock Text="{Binding SelectionA}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectionA}" />
                    <TextBlock Text="{Binding SelectionB}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectionB}" Margin="0,0,0,10" />
                    <ItemsControl ItemsSource="{Binding Drives}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,10">
                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalContentAlignment="Center" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,4" />
                                    <ItemsControl ItemsSource="{Binding Snapshots}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#FFE5E5E5" BorderThickness="1" Padding="5" Margin="12,2,0,2" ToolTip="{Binding Summary}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding DateLabel}" />
                                                            <TextBlock Text="{Binding SizeLabel}" ToolTip="{Binding SizeTooltip}" FontSize="11" Foreground="#FF606060" />
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Content="A" ToolTip="Choose as snapshot A" Padding="6,2" Margin="3,0" Command="{Binding DataContext.SelectACommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" CommandParameter="{Binding}" />
                                                        <Button Grid.Column="2" Content="B" ToolTip="Choose as snapshot B" Padding="6,2" Margin="3,0" Command="{Binding DataContext.SelectBCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" CommandParameter="{Binding}" />
                                                        <Button Grid.Column="3" Content="Delete" Padding="6,2" Margin="3,0" Command="{Binding DataContext.DeleteSnapshotCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" CommandParameter="{Binding}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <TabControl x:Name="MainTabs" Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
            <TabItem Header="Compare">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="False">
                        <Button Content="Compare" Command="{Binding CompareCommand}" Padding="10,4" Margin="0,0,8,0" />
                        <ToggleButton Content="Growth only" IsChecked="{Binding GrowthOnly, Mode=TwoWay}" Padding="10,4" Margin="0,0,8,0" />
                        <Button Content="Jump to biggest grower" Command="{Binding JumpToBiggestGrowerCommand}" Padding="10,4" Margin="0,0,12,0" />
                        <ProgressBar Width="100" Height="14" IsIndeterminate="{Binding IsComparing}" Visibility="{Binding IsComparing, Converter={StaticResource BooleanToVisibilityConverter}}" VerticalAlignment="Center" />
                    </DockPanel>
                    <ListView x:Name="ComparisonList" Grid.Row="1" ItemsSource="{Binding ComparisonRows}"
                              SelectedItem="{Binding SelectedComparisonRow, Mode=TwoWay}"
                              ScrollViewer.CanContentScroll="True" ScrollViewer.VerticalScrollBarVisibility="Auto"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                              PreviewKeyDown="ComparisonListPreviewKeyDown"
                              PreviewMouseRightButtonDown="ComparisonListPreviewMouseRightButtonDown">
                        <ListView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Open in Explorer"
                                          Command="{Binding PlacementTarget.DataContext.OpenComparisonInExplorerCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                                <MenuItem Header="Copy path"
                                          Command="{Binding PlacementTarget.DataContext.CopyComparisonPathCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                            </ContextMenu>
                        </ListView.ContextMenu>
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel VirtualizationMode="Recycling" />
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Name" Width="370">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="{Binding Depth, Converter={StaticResource DepthToIndentConverter}}">
                                                <Button Width="18" Height="18" Padding="0" Margin="0,0,4,0"
                                                        Command="{Binding DataContext.ToggleComparisonRowCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                        CommandParameter="{Binding}" IsEnabled="{Binding HasChildren}">
                                                    <TextBlock>
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="›" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                        <Setter Property="Text" Value="⌄" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Button>
                                                <TextBlock Text="{Binding DisplayName}" ToolTip="{Binding PathTooltip}" VerticalAlignment="Center" />
                                                <TextBlock Text="i" Margin="5,0,0,0" FontWeight="Bold" Foreground="#FF725A00"
                                                           ToolTip="{Binding GuidanceTooltip}" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasGuidance}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Older" Width="120">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate><TextBlock Text="{Binding OlderDisplay}" ToolTip="{Binding OlderTooltip}" /></DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Newer" Width="120">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate><TextBlock Text="{Binding NewerDisplay}" ToolTip="{Binding NewerTooltip}" /></DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Delta" Width="250">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate><TextBlock Text="{Binding DeltaDisplay}" ToolTip="{Binding DeltaTooltip}" /></DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Delta %" Width="90" DisplayMemberBinding="{Binding PercentDisplay}" />
                                <GridViewColumn Header="Delta bar" Width="120">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid Width="100" Height="12" ClipToBounds="True" ToolTip="Blue: growth; red: shrinkage. See Delta for the signed value and details.">
                                                <Border Background="#FFE5E5E5" />
                                                <Border Width="{Binding DeltaBarWidth}" HorizontalAlignment="Left">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#FF4A83C5" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsShrinkage}" Value="True"><Setter Property="Background" Value="#FFC24C4C" /></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </TabItem>
            <TabItem Header="Top growers">
                <Grid Margin="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <CheckBox Content="Shrinkers" IsChecked="{Binding Shrinkers}" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <CheckBox Content="Include root" IsChecked="{Binding IncludeRoot}" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <TextBlock Text="Minimum delta (MiB if no unit):" VerticalAlignment="Center" />
                        <TextBox Width="100" Margin="6,0,0,0" Text="{Binding MinimumDeltaText, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <TextBlock Grid.Row="1" Text="{Binding TopGrowersMessage}" Margin="0,0,0,6" TextWrapping="Wrap" />
                    <ListView Grid.Row="2" ItemsSource="{Binding TopGrowers}" MouseDoubleClick="TopGrowersDoubleClick" PreviewMouseRightButtonDown="ComparisonListPreviewMouseRightButtonDown" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Show in tree" Command="{Binding PlacementTarget.DataContext.ShowInTreeCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                                <MenuItem Header="Open in Explorer" Command="{Binding PlacementTarget.DataContext.OpenComparisonInExplorerCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                                <MenuItem Header="Copy path" Command="{Binding PlacementTarget.DataContext.CopyComparisonPathCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                            </ContextMenu>
                        </ListView.ContextMenu>
                        <ListView.View><GridView>
                            <GridViewColumn Header="Path" Width="260"><GridViewColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Path}" ToolTip="{Binding Path}" /><TextBlock Text=" i" FontWeight="Bold" Foreground="#FF725A00" ToolTip="{Binding GuidanceTooltip}" Visibility="{Binding HasGuidance, Converter={StaticResource BooleanToVisibilityConverter}}" /></StackPanel></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                            <GridViewColumn Header="Older" Width="100"><GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding OlderDisplay}" ToolTip="{Binding OlderTooltip}" /></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                            <GridViewColumn Header="Newer" Width="100"><GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding NewerDisplay}" ToolTip="{Binding NewerTooltip}" /></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                            <GridViewColumn Header="Delta" Width="260"><GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding DeltaDisplay}" ToolTip="{Binding DeltaTooltip}" /></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                            <GridViewColumn Header="Delta %" Width="80" DisplayMemberBinding="{Binding PercentDisplay}" />
                        </GridView></ListView.View>
                    </ListView>
                </Grid>
            </TabItem>
            <TabItem Header="Special folders">
                <Grid Margin="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Margin="0,0,0,8"><Run Text="Unaccounted space: " /><Run Text="{Binding SpecialFolders.UnaccountedDisplay, TargetNullValue=-}" /><Run Text="   Skipped: " /><Run Text="{Binding SpecialFolders.SkippedCount, TargetNullValue=-}" /><TextBlock.ToolTip><TextBlock Text="{Binding SpecialFolders.UnaccountedTooltip}" /></TextBlock.ToolTip></TextBlock>
                    <ListView x:Name="SpecialFoldersList" Grid.Row="1" ItemsSource="{Binding SpecialFolders.Rows}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListView.View><GridView>
                            <GridViewColumn Header="Path" Width="240" DisplayMemberBinding="{Binding Path}" />
                            <GridViewColumn Header="Rule" Width="150" DisplayMemberBinding="{Binding Title}" />
                            <GridViewColumn Header="Kind" Width="55" DisplayMemberBinding="{Binding Kind}" />
                            <GridViewColumn Header="Size" Width="100"><GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding SizeDisplay}" ToolTip="{Binding SizeTooltip}" /></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                            <GridViewColumn Header="Trend" Width="100"><GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding TrendDisplay}" ToolTip="{Binding TrendTooltip}" /></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                            <GridViewColumn Header="Flags" Width="100" DisplayMemberBinding="{Binding Flags}" />
                        </GridView></ListView.View>
                    </ListView>
                    <TextBlock Grid.Row="2" Text="Guidance (display only)" FontWeight="SemiBold" Margin="0,10,0,4" />
                    <TextBox Grid.Row="3" Text="{Binding SelectedItem.Guidance, ElementName=SpecialFoldersList}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="1" Grid.ColumnSpan="2" Padding="8" Background="#FFF3F3F3" BorderBrush="#FFD0D0D0" BorderThickness="1" CornerRadius="3">
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>
